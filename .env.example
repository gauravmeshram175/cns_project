# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=your-flask-secret-key-change-in-production

# Database
DATABASE_URL=sqlite:///mfa.db

# MFA Encryption Key (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
MFA_ENCRYPTION_KEY=your-mfa-encryption-key-change-in-production

# Security Configuration
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
SESSION_TIMEOUT_MINUTES=30
